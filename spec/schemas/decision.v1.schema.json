{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NikhilSetiya/stopbar/spec/schemas/decision.v1.schema.json",
  "title": "Stopbar Decision v1",
  "description": "LLD \u00a73.4. Mirrors internal/model.Decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "outcome",
    "reasons",
    "policy_bundle_hash",
    "payload_hash",
    "approvals",
    "reservation_id",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "allow",
        "deny",
        "escalate"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_id",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "policy_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "policy_bundle_hash": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64})?$"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64})?$"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "approver",
          "at",
          "signature"
        ]
      }
    },
    "reservation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
      "description": "Decision token (spec/decision-token-v1.md); allow only."
    },
    "signed_tx": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$",
      "description": "Gatekeeper mode, allow only: raw signed EIP-1559 transaction."
    },
    "tx_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "description": "Hash of signed_tx."
    }
  },
  "if": {
    "properties": {
      "outcome": {
        "enum": [
          "deny",
          "escalate"
        ]
      }
    }
  },
  "then": {
    "properties": {
      "reasons": {
        "minItems": 1
      }
    }
  }
}
