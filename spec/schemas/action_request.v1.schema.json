{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/setiyanikhil/stopbar/spec/schemas/action_request.v1.schema.json",
  "title": "Stopbar ActionRequest v1",
  "description": "LLD \u00a73.1. Mirrors internal/model.ActionRequest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant",
    "nonce",
    "issued_at",
    "ttl_seconds",
    "actor",
    "action",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 16
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "workload_identity": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "on_behalf_of": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "evm_tx",
            "tool_call",
            "withdrawal"
          ]
        },
        "chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "value_wei": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "data": {
          "type": "string",
          "pattern": "^0x([0-9a-fA-F]{2})*$"
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evm_tx"
              }
            }
          },
          "then": {
            "required": [
              "chain_id",
              "from",
              "to",
              "value_wei"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "to": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool_call"
              }
            }
          },
          "then": {
            "required": [
              "tool"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "withdrawal"
              }
            }
          },
          "then": {
            "required": [
              "to"
            ]
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "ref"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "hash": {
                "type": "string"
              }
            }
          }
        },
        "sdk": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        }
      }
    },
    "parent_request_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
