{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NikhilSetiya/stopbar/spec/schemas/action_request.v1.schema.json",
  "title": "Stopbar ActionRequest v1",
  "description": "LLD \u00a73.1. Mirrors internal/model.ActionRequest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant",
    "nonce",
    "issued_at",
    "ttl_seconds",
    "actor",
    "action",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 16
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "workload_identity": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "on_behalf_of": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "evm_tx",
            "tool_call",
            "withdrawal",
            "evm_typed_data",
            "evm_personal_sign"
          ]
        },
        "chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "value_wei": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "data": {
          "type": "string",
          "pattern": "^0x([0-9a-fA-F]{2})*$"
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": [
            "object",
            "null"
          ]
        },
        "tx_type": {
          "const": 2,
          "description": "EIP-1559 only"
        },
        "tx_nonce": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "gas_limit": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_fee_per_gas": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "max_priority_fee_per_gas": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "typed_data": {
          "description": "evm_typed_data: the EIP-712 payload as eth_signTypedData_v4 takes it. Integers are decimal strings or JSON integers within ±2^53 (never hex); domain.chainId is required and equals chain_id; domain members are declared in standard order. internal/model checks every value against its declared type.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "types",
            "primaryType",
            "domain",
            "message"
          ],
          "properties": {
            "types": {
              "type": "object",
              "required": [
                "EIP712Domain"
              ],
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                    },
                    "type": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "primaryType": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "type": "object",
              "required": [
                "chainId"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "chainId": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "verifyingContract": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "salt": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{64}$"
                }
              }
            },
            "message": {
              "type": "object"
            }
          }
        },
        "message": {
          "description": "evm_personal_sign: the bytes to sign (EIP-191), 0x-prefixed hex.",
          "type": "string",
          "pattern": "^0x([0-9a-fA-F]{2})+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evm_tx"
              }
            }
          },
          "then": {
            "required": [
              "chain_id",
              "from",
              "to",
              "value_wei",
              "tx_type",
              "tx_nonce",
              "gas_limit",
              "max_fee_per_gas",
              "max_priority_fee_per_gas"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "to": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool_call"
              }
            }
          },
          "then": {
            "required": [
              "tool"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "withdrawal"
              }
            }
          },
          "then": {
            "required": [
              "to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "evm_typed_data",
                  "evm_personal_sign"
                ]
              }
            }
          },
          "then": {
            "required": [
              "chain_id",
              "from"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "to": false,
              "value_wei": false,
              "data": false,
              "tx_type": false,
              "tx_nonce": false,
              "gas_limit": false,
              "max_fee_per_gas": false,
              "max_priority_fee_per_gas": false,
              "tool": {
                "type": "null"
              },
              "args": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evm_typed_data"
              }
            }
          },
          "then": {
            "required": [
              "typed_data"
            ],
            "properties": {
              "message": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evm_personal_sign"
              }
            }
          },
          "then": {
            "required": [
              "message"
            ],
            "properties": {
              "typed_data": false
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "ref"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "hash": {
                "type": "string"
              }
            }
          }
        },
        "sdk": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        }
      }
    },
    "parent_request_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
